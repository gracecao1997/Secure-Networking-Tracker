# Public Neon Managed Better Auth URL. Safe for the browser.
NEXT_PUBLIC_NEON_AUTH_URL="https://your-auth-host.neon.build/your-db/auth"

# Public Neon Data API REST URL. Safe for the browser when RLS is enabled.
NEXT_PUBLIC_NEON_DATA_API_URL="https://your-data-api-host.neon.build/your-db/rest/v1"

# Server-only variables. Keep real values in .env.local and Vercel only.
DATABASE_URL="postgresql://placeholder"
NEON_AUTH_BASE_URL="https://your-auth-host.neon.build/your-db/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-secret"
